const el = (tag, cls, text) => {
  const n = document.createElement(tag);
  if (cls) n.className = cls;
  if (text) n.textContent = text;
  return n;
};

/* Projects */
const projectGrid = document.getElementById("project-grid");
PROJECTS.forEach(p => {
  const card = el("article", "card");
  card.append(el("h3", "", p.title), el("p", "meta", p.type), el("p", "", p.description));

  if (p.tags && p.tags.length) {
    const tags = el("ul", "tags");
    p.tags.forEach(t => tags.append(el("li", "", t)));
    card.append(tags);
  }

  const links = el("div", "links");
  if (p.live) {
    const a = el("a", "btn small primary", "View app or release");
    a.href = p.live; a.target = "_blank"; a.rel = "noopener";
    links.append(a);
  }
  if (p.code) {
    const a = el("a", "btn small", "Source code");
    a.href = p.code; a.target = "_blank"; a.rel = "noopener";
    links.append(a);
  }
  if (!p.live && !p.code) links.append(el("span", "badge", "Link coming soon"));
  card.append(links);
  projectGrid.append(card);
});

/* Certificates */
const certGrid = document.getElementById("cert-grid");
CERTIFICATES.forEach(c => {
  const card = el("button", "card cert");
  card.type = "button";
  card.append(
    el("h3", "", c.title),
    el("p", "", c.issuer),
    el("p", "meta", String(c.year)),
    el("span", "view", "View certificate")
  );
  card.addEventListener("click", () => openCertificate(c));
  certGrid.append(card);
});

/* Certificate viewer */
const viewer = document.getElementById("viewer");
const viewerTitle = document.getElementById("viewer-title");
const viewerBody = document.getElementById("viewer-body");
const viewerOpen = document.getElementById("viewer-open");
let lastFocus = null;

async function openCertificate(c) {
  lastFocus = document.activeElement;
  viewerTitle.textContent = c.title;
  viewerBody.replaceChildren();
  viewerOpen.href = c.file;
  viewer.hidden = false;
  document.body.style.overflow = "hidden";
  document.getElementById("viewer-close").focus();

  let exists = false;
  try { exists = (await fetch(c.file, { method: "HEAD" })).ok; } catch (e) { exists = false; }

  if (!exists) {
    viewerOpen.classList.add("disabled");
    viewerBody.append(el("p", "msg", "This certificate has not been uploaded yet. Add the file to the certificates folder and it will appear here."));
    return;
  }
  viewerOpen.classList.remove("disabled");

  if (/\.pdf$/i.test(c.file)) {
    const frame = document.createElement("iframe");
    frame.src = c.file;
    frame.title = c.title;
    viewerBody.append(frame);
  } else {
    const img = document.createElement("img");
    img.src = c.file;
    img.alt = "Certificate: " + c.title;
    viewerBody.append(img);
  }
}

function closeViewer() {
  viewer.hidden = true;
  viewerBody.replaceChildren();
  document.body.style.overflow = "";
  if (lastFocus) lastFocus.focus();
}

document.getElementById("viewer-close").addEventListener("click", closeViewer);
viewer.addEventListener("click", e => { if (e.target === viewer) closeViewer(); });
document.addEventListener("keydown", e => { if (e.key === "Escape" && !viewer.hidden) closeViewer(); });

/* Mobile menu */
const menuBtn = document.querySelector(".menu-btn");
const navLinks = document.querySelector(".nav-links");
menuBtn.addEventListener("click", () => {
  const open = navLinks.classList.toggle("open");
  menuBtn.setAttribute("aria-expanded", open);
});
navLinks.addEventListener("click", e => {
  if (e.target.tagName === "A") { navLinks.classList.remove("open"); menuBtn.setAttribute("aria-expanded", false); }
});
